	template <size_t _Ip, class _Hp,
          bool=is_empty<_Hp>::value && !__libcpp_is_final<_Hp>::value
		>
	class __tuple_leaf;

	template <size_t _Ip, class _Hp, bool _Ep>
	inline void swap(__tuple_leaf<_Ip, _Hp, _Ep>& __x, __tuple_leaf<_Ip, _Hp, _Ep>& __y)
		noexcept(__is_nothrow_swappable<_Hp>::value)
	{
		swap(__x.get(), __y.get());
	}

	template <size_t _Ip, class _Hp, bool>
	class __tuple_leaf
	{
		_Hp __value_;

		template <class _Tp>
		static constexpr bool __can_bind_reference() {
			return true;
		}

		__tuple_leaf& operator=(const __tuple_leaf&);
	public:
		inline constexpr __tuple_leaf()
			 : __value_()
		{static_assert(!is_reference<_Hp>::value,
				"Attempted to default construct a reference element in a tuple");}

		template <class _Alloc>
		inline __tuple_leaf(integral_constant<int, 0>, const _Alloc&)
			: __value_()
		{static_assert(!is_reference<_Hp>::value,
			"Attempted to default construct a reference element in a tuple");}

		template <class _Alloc>
		inline __tuple_leaf(integral_constant<int, 2>, const _Alloc& __a)
			: __value_(__a)
		{static_assert(!is_reference<_Hp>::value,
			"Attempted to default construct a reference element in a tuple");}

		__tuple_leaf(const __tuple_leaf& __t) = default;
		__tuple_leaf(__tuple_leaf&& __t) = default;

		template <class _Tp>
		inline __tuple_leaf& operator=(_Tp&& __t) /* _NOEXCEPT_((is_nothrow_assignable<_Hp&, _Tp>::value)) */
		{
			__value_ = static_cast<_Tp&&>(__t);
			return *this;
		}

		inline int swap(__tuple_leaf& __t) noexcept(__is_nothrow_swappable<__tuple_leaf>::value)
		{
			std::swap(*this, __t);
			return 0;
		}

		inline constexpr       _Hp& get()       noexcept {return __value_;}
		inline constexpr const _Hp& get() const noexcept {return __value_;}
	};

	template <size_t _Ip, class _Hp>
	class __tuple_leaf<_Ip, _Hp, true>
		: private _Hp
	{
		__tuple_leaf& operator=(const __tuple_leaf&);

	public:
		inline constexpr __tuple_leaf()
			/* noexcfept(is_nothrow_default_constructible<_Hp>::value) */ {}

		template <class _Alloc>
		inline __tuple_leaf(integral_constant<int, 0>, const _Alloc&) {}

		template <class _Alloc>
		inline __tuple_leaf(integral_constant<int, 2>, const _Alloc& __a)
			: _Hp(__a) {}

		template <class _Tp, class _Alloc>
		inline explicit __tuple_leaf(integral_constant<int, 0>, const _Alloc&, _Tp&& __t)
			: _Hp(static_cast<_Tp&&>(__t)) {}

		template <class _Tp, class _Alloc>
		inline explicit __tuple_leaf(integral_constant<int, 2>, const _Alloc& __a, _Tp&& __t)
			: _Hp(static_cast<_Tp&&>(__t), __a) {}

		__tuple_leaf(__tuple_leaf const &) = default;
		__tuple_leaf(__tuple_leaf &&) = default;

		template <class _Tp>
		inline __tuple_leaf&
		operator=(_Tp&& __t) /* noexcept((is_nothrow_assignable<_Hp&, _Tp>::value)) */
		{
			_Hp::operator=(static_cast<_Tp&&>(__t));
			return *this;
		}

		inline int swap(__tuple_leaf& __t) noexcept(__is_nothrow_swappable<__tuple_leaf>::value)
		{
			std::swap(*this, __t);
			return 0;
		}

		inline constexpr       _Hp& get()       noexcept {return static_cast<_Hp&>(*this);}
		inline constexpr const _Hp& get() const noexcept {return static_cast<const _Hp&>(*this);}
	};

